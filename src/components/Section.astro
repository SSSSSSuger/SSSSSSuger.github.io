---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
}

const { id, eyebrow, title, description, class: className = "" } = Astro.props;
---

<section id={id} class:list={["section", className]}>
  <header class="section-heading">
    {eyebrow && <p class="section-eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </header>
  <slot />
</section>
