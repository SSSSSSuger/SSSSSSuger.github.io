---
import { profile, profileLinks } from "../data/profile";
import LinkButton from "./LinkButton.astro";

const links = [
  { href: profileLinks.scholar, label: "Google Scholar", variant: "primary" as const },
  { href: profileLinks.github, label: "GitHub" },
  { href: profileLinks.email, label: "Email" },
  ...(profileLinks.cv ? [{ href: profileLinks.cv, label: "CV" }] : []),
];
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <p class="hero-intro">Hello, I’m</p>
    <h1 id="hero-title">
      <span class="latin-name">Zhihao Zhu</span><span class="name-separator"> / </span><span class="cn-name" lang="zh-CN">朱志浩</span>
    </h1>
    <p class="hero-title">{profile.title}</p>
    <p class="hero-summary">{profile.summary}</p>
    <div class="hero-actions" aria-label="Profile links">
      {links.map((link) => <LinkButton {...link} />)}
    </div>
    <ul class="keyword-list" aria-label="Research areas">
      {profile.keywords.map((keyword) => <li>{keyword}</li>)}
    </ul>
  </div>
  <figure class="hero-avatar">
    <img src={profile.avatar} alt="Portrait of Zhihao Zhu" width="420" height="420" loading="eager" fetchpriority="high" />
  </figure>
</section>
