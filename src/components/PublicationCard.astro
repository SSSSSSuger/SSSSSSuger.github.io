---
import type { Publication } from "../data/publications";
interface Props { publication: Publication }
const { publication } = Astro.props;
const authorParts = publication.authors.split(/(Zhihao Zhu\*?)/g);
---

<article class:list={["publication", { featured: publication.featured }]}>
  <div class="publication-body">
    <div class="publication-meta">
      <span class="venue-badge">{publication.venue}</span>
      {publication.featured && <span class="featured-label">Featured work</span>}
    </div>
    <h3>{publication.title}</h3>
    <p class="authors">
      {authorParts.map((part) => part.startsWith("Zhihao Zhu") ? <strong>{part}</strong> : part)}
    </p>
    <p class="publication-description">{publication.description}</p>
    {publication.metrics && (
      <ul class="publication-metrics" aria-label="Key results">
        {publication.metrics.map((metric) => <li>{metric}</li>)}
      </ul>
    )}
    <div class="publication-links" aria-label={`${publication.title} resources`}>
      {publication.links.map((link) => {
        const external = link.href.startsWith("http");
        return (
          <a href={link.href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>
            {link.label}<span aria-hidden="true"> ↗</span>
          </a>
        );
      })}
    </div>
  </div>
</article>
