---
import { profile } from "../data/profile";

const navItems = [
  ["About", "#about"],
  ["Research", "#research"],
  ["Publications", "#publications"],
  ["Projects", "#projects"],
  ["Experience", "#experience"],
  ["Contact", "#contact"],
] as const;
---

<header class="site-header">
  <nav class="nav-shell" aria-label="Main navigation">
    <a class="brand" href="#top" aria-label="Back to top">{profile.name}</a>
    <div class="nav-links">
      {navItems.map(([label, href]) => <a href={href}>{label}</a>)}
    </div>
  </nav>
</header>
