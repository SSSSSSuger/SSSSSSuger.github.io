---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import NewsList from "../components/NewsList.astro";
import ResearchCard from "../components/ResearchCard.astro";
import PublicationCard from "../components/PublicationCard.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import Footer from "../components/Footer.astro";
import LinkButton from "../components/LinkButton.astro";
import { experience } from "../data/experience";
import { news } from "../data/news";
import { publications } from "../data/publications";
import { profile, profileLinks, seo } from "../data/profile";
import { researchInterests } from "../data/research";
import "../styles/global.css";

const contactLinks = [
  { href: profileLinks.email, label: "Email", variant: "primary" as const },
  { href: profileLinks.scholar, label: "Google Scholar" },
  { href: profileLinks.github, label: "GitHub" },
  ...(profileLinks.cv ? [{ href: profileLinks.cv, label: "CV" }] : []),
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.shortName,
  alternateName: "朱志浩",
  url: seo.canonical,
  image: `${seo.canonical}avatar.jpg`,
  affiliation: { "@type": "CollegeOrUniversity", name: "Fudan University" },
  jobTitle: "Master’s Student",
  sameAs: [profileLinks.github, profileLinks.scholar],
  knowsAbout: profile.keywords,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="keywords" content={seo.keywords} />
    <meta name="author" content={seo.author} />
    <meta name="theme-color" content="#fcfcfd" />
    <link rel="canonical" href={seo.canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Zhihao Zhu — Efficient Generative VLA Models for Autonomous Driving" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <Hero />

      <Section eyebrow="Recent Updates" title="News" class="news-section">
        <NewsList items={news} />
      </Section>

      <Section
        id="publications"
        eyebrow="Selected Publications"
        title="Research at the intersection of generation and action"
        description="Selected work on efficient, parallel generative models for autonomous driving. * Equal contribution. † Corresponding author."
      >
        <div class="publication-list">
          {publications.map((publication) => <PublicationCard publication={publication} />)}
        </div>
      </Section>

      <Section
        id="research"
        eyebrow="Research"
        title="Three connected research directions"
      >
        <div class="research-grid">
          {researchInterests.map((item, index) => <ResearchCard item={item} index={index} />)}
        </div>
      </Section>

      <Section id="experience" eyebrow="Experience & Education" title="Academic background">
        <ExperienceTimeline items={experience} />
      </Section>

      <Section id="contact" eyebrow="Contact" title="Let’s discuss research">
        <div class="contact-content">
          <p>I am open to research discussions and collaborations on efficient multimodal generative models and autonomous driving.</p>
          <div class="hero-actions" aria-label="Contact links">
            {contactLinks.map((link) => <LinkButton {...link} />)}
          </div>
        </div>
      </Section>
    </main>
    <Footer />
  </body>
</html>
